{
  "name": "vytty",
  "productName": "Vytty",
  "version": "0.11.0",
  "description": "Portable SSH / Telnet / Serial terminal with session manager, encrypted password vault, daily logs, Cisco / Linux syntax highlighting and imports from MobaXterm, PuTTY, SecureCRT and mRemoteNG. Rust (Tauri) backend.",
  "author": "Vytty contributors",
  "license": "MIT",
  "homepage": "https://github.com/mtgmz14/vytty",
  "repository": {
    "type": "git",
    "url": "https://github.com/mtgmz14/vytty.git"
  },
  "keywords": [
    "cisco",
    "mobaxterm",
    "netbox",
    "portable",
    "putty",
    "rust",
    "securecrt",
    "serial",
    "sftp",
    "ssh",
    "tauri",
    "telnet",
    "terminal"
  ],
  "scripts": {
    "build:ui": "node scripts/build-ui.js",
    "start": "node scripts/build-ui.js && cargo run -p vytty",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:rust": "cargo test --workspace",
    "test:e2e": "node scripts/build-ui.js && cargo build -p vytty && node test/e2e/run.js",
    "dist:win": "node scripts/build-ui.js && cargo build --release -p vytty && node scripts/package-win.js",
    "dist:linux": "tauri build --bundles appimage",
    "checksums": "node scripts/checksums.js dist",
    "release:sign": "node scripts/sign-release.js",
    "tauri": "tauri"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "ssh2": "^1.17.0"
  },
  "private": true
}
