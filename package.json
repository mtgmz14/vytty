{
  "name": "vytty",
  "productName": "Vytty",
  "version": "0.10.0",
  "description": "Portable SSH / Telnet / Serial terminal with session manager, encrypted password vault, daily logs, Cisco / Linux syntax highlighting and imports from MobaXterm, PuTTY, SecureCRT and mRemoteNG.",
  "main": "src/main/main.js",
  "author": "Vytty contributors",
  "license": "MIT",
  "homepage": "https://github.com/mtgmz14/vytty",
  "repository": {
    "type": "git",
    "url": "https://github.com/mtgmz14/vytty.git"
  },
  "keywords": [
    "cisco",
    "electron",
    "mobaxterm",
    "netbox",
    "portable",
    "putty",
    "securecrt",
    "serial",
    "sftp",
    "ssh",
    "telnet",
    "terminal"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --devtools",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "node test/e2e/run.js",
    "dist:win": "electron-builder --win dir --x64 --publish never && node scripts/package-win.js",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never",
    "dist:mac": "electron-builder --mac zip --publish never",
    "checksums": "node scripts/checksums.js dist",
    "icon": "electron scripts/make-icon.js"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "serialport": "^13.0.0",
    "ssh2": "^1.17.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "electron": "^44.11.3",
    "electron-builder": "^26.18.1"
  },
  "build": {
    "appId": "io.github.vytty",
    "productName": "Vytty",
    "copyright": "MIT License",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.map",
      "!node_modules/cpu-features/**",
      "!node_modules/**/*.md",
      "!node_modules/@serialport/bindings-cpp/prebuilds/{android,darwin,linux}*/**",
      "!node_modules/@lydell/node-pty-*/prebuilds/{darwin,linux}*/**"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**",
      "node_modules/@serialport/**"
    ],
    "electronLanguages": [
      "en-US",
      "pl"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "legalTrademarks": "",
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "artifactName": "Vytty-${version}.${ext}",
      "executableName": "vytty"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    }
  }
}
