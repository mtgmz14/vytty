{
  "name": "vytty",
  "productName": "Vytty",
  "version": "0.6.0",
  "description": "Portable SSH / Telnet / Serial terminal with session manager, encrypted password vault, daily logs and Cisco/Linux syntax highlighting.",
  "main": "src/main/main.js",
  "author": "Vytty contributors",
  "license": "MIT",
  "homepage": "https://github.com/mtgmz14/vytty",
  "repository": {
    "type": "git",
    "url": "https://github.com/mtgmz14/vytty.git"
  },
  "keywords": [
    "ssh",
    "telnet",
    "serial",
    "terminal",
    "cisco",
    "sftp",
    "portable",
    "electron"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --devtools",
    "dist:win": "electron-builder --win portable --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never",
    "dist:mac": "electron-builder --mac zip --publish never",
    "icon": "electron scripts/make-icon.js"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "serialport": "^13.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.vytty",
    "productName": "Vytty",
    "copyright": "MIT License",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.map",
      "!node_modules/cpu-features/**",
      "!node_modules/**/*.md",
      "!node_modules/@serialport/bindings-cpp/prebuilds/{android,darwin,linux}*/**",
      "!node_modules/@lydell/node-pty-*/prebuilds/{darwin,linux}*/**"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**",
      "node_modules/@serialport/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Vytty-${version}-portable.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "npmRebuild": false
  }
}
