{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vytty",
  "version": "0.11.0",
  "identifier": "io.github.vytty",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "node scripts/build-ui.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Utility",
    "shortDescription": "Portable SSH / Telnet / Serial terminal",
    "longDescription": "Portable SSH / Telnet / Serial terminal with session manager, encrypted password vault, daily logs, Cisco / Linux syntax highlighting and imports from MobaXterm, PuTTY, SecureCRT and mRemoteNG.",
    "copyright": "MIT License",
    "publisher": "Vytty (github.com/mtgmz14/vytty)",
    "homepage": "https://github.com/mtgmz14/vytty",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "linux": {
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
